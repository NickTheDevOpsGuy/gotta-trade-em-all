{
  "name": "tradedex-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=1 tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "npx lighthouse http://localhost:4173 --output=html --output-path=./lighthouse-report.html --chrome-flags='--headless --no-sandbox'"
  },
  "dependencies": {
    "@sentry/react": "^10.39.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/analytics": "^1.4.1",
    "framer-motion": "^11.11.17",
    "lz-string": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.6"
  }
}
