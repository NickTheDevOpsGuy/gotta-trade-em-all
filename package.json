{
  "name": "gotta-trade-em-all",
  "private": true,
  "version": "1.0.0",
  "description": "A React-based trading game inspired by collectible monster card mechanics",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build:vercel --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "test": "npm run test --workspace=frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "reinstall": "rm -rf node_modules frontend/node_modules backend/node_modules api/node_modules && npm install",
    "husky:setup": "husky",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces"
  },
  "workspaces": [
    "frontend",
    "backend",
    "api"
  ],
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "cd frontend && npm run lint:fix",
      "npx prettier --write",
      "cd frontend && npx tsc --noEmit",
      "cd frontend && npm run test"
    ]
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "tar": "^7.5.8",
    "path-to-regexp": "^6.2.3",
    "undici": "^6.22.1",
    "esbuild": "^0.25.0",
    "@eslint/eslintrc": {
      "ajv": "^6.15.0"
    },
    "eslint": {
      ".": "8.57.1",
      "ajv": "^6.15.0"
    },
    "fast-uri": "^3.1.2"
  }
}
